<Window x:Class="HaloPixelLyric.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloPixelLyric"
        Width="980" Height="700"
        MinWidth="880" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="{StaticResource AppLogoImage}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="Root" ClipToBounds="True">

            <!-- 背景氛围光 -->
            <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-170,0" Fill="{DynamicResource GlowBrush1}"
                     IsHitTestVisible="False" />
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-280" Fill="{DynamicResource GlowBrush2}"
                     IsHitTestVisible="False" />

            <!-- ============================== 主体 ============================== -->
            <Grid x:Name="MainRoot" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ 自定义标题栏 ============ -->
                <Grid Grid.Row="0">
                    <!-- 标题 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="HaloPixelLyric" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="7,2"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" Text="v1.4.0" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧控件：主题 + Win11 窗口按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                Click="ThemeBtn_Click" ToolTip="切换深色 / 浅色外观">
                            <Grid Width="16" Height="16">
                                <Rectangle x:Name="MoonIcon" Width="15" Height="15"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/moon.png" Stretch="Uniform" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle x:Name="SunIcon" Width="15" Height="15" Visibility="Collapsed"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/sun.png" Stretch="Uniform" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </Button>
                        <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                Click="MinBtn_Click" ToolTip="最小化" />
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="MaxBtn_Click" ToolTip="最大化" />
                        <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                                Click="CloseBtn_Click" ToolTip="关闭到托盘" />
                    </StackPanel>
                </Grid>

                <!-- ============ 侧栏 + 内容 ============ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 侧栏 ===== -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,1,0">
                        <Grid Margin="14,6,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 品牌 -->
                            <StackPanel Orientation="Horizontal" Margin="6,10,0,20">
                                <Image Source="{StaticResource AppLogoImage}" Width="42" Height="42"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="12,2,0,0">
                                    <TextBlock Text="HaloPixelLyric" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="像素歌词同步" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 导航 -->
                            <Grid Grid.Row="1">
                                <Border x:Name="NavHighlight" Height="40" VerticalAlignment="Top" Margin="0,2,0,0"
                                        CornerRadius="10" Background="{DynamicResource CardBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10"
                                                          Direction="270" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="NavHighlightTransform" />
                                    </Border.RenderTransform>
                                </Border>

                                <StackPanel>
                                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="0"
                                                 Checked="Nav_Checked" GroupName="Nav">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="20" VerticalAlignment="Center">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/home.png" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                            <TextBlock Text="控制台" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavParams" Style="{StaticResource NavItem}" Tag="1"
                                                 Checked="Nav_Checked" GroupName="Nav">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="20" VerticalAlignment="Center">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/sliders.png" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                            <TextBlock Text="显示参数" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" Tag="2"
                                                 Checked="Nav_Checked" GroupName="Nav">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="20" VerticalAlignment="Center">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/document.png" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                            <TextBlock Text="运行日志" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="3"
                                                 Checked="Nav_Checked" GroupName="Nav">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="20" VerticalAlignment="Center">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/info.png" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                            <TextBlock Text="关于" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>

                            <!-- 侧栏底部状态 -->
                            <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse Width="16" Height="16" Stroke="{DynamicResource SuccessBrush}"
                                                 StrokeThickness="1" Opacity="0.22" />
                                        <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7"
                                                 Fill="{DynamicResource SuccessBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 RenderTransformOrigin="0.5,0.5" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock x:Name="SidebarStatusText" Text="未启动" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="SidebarStatusDetail" Text="花再 Halo PixelBar"
                                                   FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ===== 内容区 ===== -->
                    <Grid Grid.Column="1" x:Name="PageHost" Margin="30,6,30,24">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <!-- ==================== 控制台 ==================== -->
                        <Grid x:Name="PageHome">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="190" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="88" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,4,0,18">
                                <StackPanel>
                                    <TextBlock Text="控制台" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="歌词同步状态与像素屏实时预览" FontSize="12.5" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="HomeLogBtn" Style="{StaticResource GhostButton}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="HomeLogBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Rectangle Width="14" Height="14" Fill="{DynamicResource AccentBrush}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/document.png" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Text="查看运行日志" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Hero 状态卡 -->
                            <Border Grid.Row="1" CornerRadius="18" Background="{DynamicResource HeroBrush}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Ellipse Width="280" Height="280" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#24FFFFFF" Offset="0" />
                                                <GradientStop Color="#0CFFFFFF" Offset="0.55" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <Grid Margin="26,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <Border Background="{DynamicResource HeroPillBrush}"
                                                    BorderBrush="{DynamicResource HeroPillBorderBrush}"
                                                    BorderThickness="1" CornerRadius="11" Padding="9,3"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="HeroDot" Width="7" Height="7"
                                                             Fill="{DynamicResource SuccessBrush}"
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="0.5,0.5" />
                                                    <TextBlock x:Name="HeroStatusText" Text="已停止" FontSize="11"
                                                               Foreground="#FFFFFF" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock x:Name="HeroTitle" Text="准备就绪" FontSize="25"
                                                       FontWeight="Bold" Foreground="#FFFFFF" Margin="0,9,0,0" />
                                            <TextBlock x:Name="HeroSubtitle" Text="点击启动，让像素屏跟着歌词呼吸"
                                                       FontSize="12.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource HeroSecondaryTextBrush}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <Button x:Name="ToggleBtn" Style="{StaticResource HeroPrimaryButton}"
                                                        Content="启动同步" Click="ToggleBtn_Click" />
                                                <TextBlock x:Name="NowPlayingText" Text="等待播放…"
                                                           Foreground="{DynamicResource HeroSecondaryTextBrush}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Margin="14,0,0,0" MaxWidth="300"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 声波 -->
                                        <Grid Grid.Column="1" Width="188" Height="66" VerticalAlignment="Center"
                                              Margin="10,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle x:Name="Wave1" Grid.Column="0" Width="6" Height="20"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave2" Grid.Column="1" Width="6" Height="34"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave3" Grid.Column="2" Width="6" Height="48"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave4" Grid.Column="3" Width="6" Height="58"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave5" Grid.Column="4" Width="6" Height="46"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave6" Grid.Column="5" Width="6" Height="30"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Wave7" Grid.Column="6" Width="6" Height="18"
                                                       RadiusX="3" RadiusY="3" Fill="#EBFFFFFF"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="0.32" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 当前歌词 -->
                            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="24,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前歌词" Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                                Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="实时" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <TextBlock Text="“" FontFamily="Georgia" FontSize="54" Opacity="0.14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="2,-10,0,0" IsHitTestVisible="False" />
                                        <TextBlock Text="”" FontFamily="Georgia" FontSize="54" Opacity="0.14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,2,-26" IsHitTestVisible="False" />

                                        <Rectangle x:Name="LyricIdleIcon" Width="26" Height="26"
                                                   Opacity="0.4" Margin="0,0,0,88"
                                                   Fill="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="/Assets/Icons/music.png" Stretch="Uniform" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock x:Name="LyricText" Text="等待播放…" FontSize="23"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextAlignment="Center" LineHeight="34"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   MaxWidth="580" Opacity="0.55" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <TextBlock Text="与像素屏内容逐行同步" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="SongTitleText" Text="" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 连接信息 -->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{DynamicResource AccentBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="/Assets/Icons/music.png" Stretch="Uniform" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                            <TextBlock Text="播放器" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="网易云音乐" FontSize="13" FontWeight="Medium"
                                                       Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{DynamicResource AccentBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="/Assets/Icons/speaker.png" Stretch="Uniform" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                            <TextBlock Text="设备" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="花再 Halo PixelBar" FontSize="13" FontWeight="Medium"
                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <Rectangle Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{DynamicResource AccentBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="/Assets/Icons/globe.png" Stretch="Uniform" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                            <TextBlock Text="通道" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="CDP:9222" FontSize="13" FontWeight="Medium"
                                                       Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ==================== 显示参数 ==================== -->
                        <Grid x:Name="PageParams" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <StackPanel>
                                    <Grid Margin="0,4,0,18">
                                        <StackPanel>
                                            <TextBlock Text="显示参数" FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="微调歌词在像素屏上的节奏与容量" FontSize="12.5"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="ResetBtn" Style="{StaticResource SoftButton}"
                                                    Content="恢复默认" Click="ResetBtn_Click" />
                                            <Button x:Name="SaveBtn" Style="{StaticResource AccentButton}"
                                                    Content="保存参数" Margin="10,0,0,0" Click="SaveBtn_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource Card}" Padding="20,6">
                                        <StackPanel>
                                            <!-- 翻页提前量 -->
                                            <Grid Height="86">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <DockPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBrush}"
                                                            CornerRadius="8" Padding="10,4" MinWidth="72"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="LeadValue" Text="280 ms"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="翻页提前量" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="句内换页提前触发，抵消链路与固件动画延迟"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="LeadSlider" Grid.Row="1" Style="{StaticResource AppleSlider}"
                                                        Minimum="0" Maximum="1000" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" ValueChanged="ParamSlider_ValueChanged"
                                                        Margin="0,2,0,0" />
                                                <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SeparatorBrush}" />
                                            </Grid>

                                            <!-- 预推提前量 -->
                                            <Grid Height="86">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <DockPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBrush}"
                                                            CornerRadius="8" Padding="10,4" MinWidth="72"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="PreValue" Text="350 ms"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="预推提前量" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="每句第一屏的独立提前量，通常比翻页略大"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="PreSlider" Grid.Row="1" Style="{StaticResource AppleSlider}"
                                                        Minimum="0" Maximum="1000" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" ValueChanged="ParamSlider_ValueChanged"
                                                        Margin="0,2,0,0" />
                                                <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SeparatorBrush}" />
                                            </Grid>

                                            <!-- 屏幕容量 -->
                                            <Grid Height="86">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <DockPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBrush}"
                                                            CornerRadius="8" Padding="10,4" MinWidth="72"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="UnitsValue" Text="16.0 字"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="屏幕容量" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="一行可容纳的全角单位（半角算 0.5）"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="UnitsSlider" Grid.Row="1" Style="{StaticResource AppleSlider}"
                                                        Minimum="8" Maximum="24" TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True" ValueChanged="ParamSlider_ValueChanged"
                                                        Margin="0,2,0,0" />
                                                <Border Grid.RowSpan="2" Height="1" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SeparatorBrush}" />
                                            </Grid>

                                            <!-- 间奏钳制倍数 -->
                                            <Grid Height="86">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <DockPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBrush}"
                                                            CornerRadius="8" Padding="10,4" MinWidth="72"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="InterludeValue" Text="3.0 ×"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="间奏钳制倍数" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="官方句长超过估算值 N 倍时按间奏处理"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="InterludeSlider" Grid.Row="1" Style="{StaticResource AppleSlider}"
                                                        Minimum="1.5" Maximum="10" TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True" ValueChanged="ParamSlider_ValueChanged"
                                                        Margin="0,2,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,14,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock FontSize="11.5" LineHeight="19" Margin="9,0,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="参数只影响显示节奏：翻页 / 预推变大→更早切换；容量决定单页字数；间奏倍数越大，越不容易把长间奏误判为演唱。修改后点右上角保存立即生效。" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ==================== 运行日志 ==================== -->
                        <Grid x:Name="PageLog" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,4,0,18">
                                <StackPanel>
                                    <TextBlock Text="运行日志" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="同步链路的实时反馈，便于排查问题" FontSize="12.5"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="OpenLogBtn" Style="{StaticResource GhostButton}"
                                            Content="打开日志文件" Click="OpenLogBtn_Click" />
                                    <Button x:Name="ClearLogBtn" Style="{StaticResource GhostButton}"
                                            Content="清空" Margin="6,0,0,0" Click="ClearLogBtn_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource Card}"
                                    Background="{DynamicResource LogBackgroundBrush}" Padding="8">
                                <Grid>
                                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource LogListItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10.5" Margin="2,1,0,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11.5" TextWrapping="Wrap"
                                                               LineHeight="18">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ok">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="warn">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="err">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="dbg">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextTertiaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="LogEmpty" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Opacity="0.6"
                                                   Fill="{DynamicResource TextTertiaryBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="/Assets/Icons/document.png" Stretch="Uniform" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock Text="启动同步后，这里会显示实时日志" FontSize="11.5"
                                                   Margin="0,10,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==================== 关于 ==================== -->
                        <Grid x:Name="PageAbout" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <StackPanel>
                                    <Grid Margin="0,4,0,18">
                                        <StackPanel>
                                            <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="一个把歌词送进像素屏的小工具" FontSize="12.5"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource Card}" Padding="24,22">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{StaticResource AppLogoImage}" Width="78" Height="78"
                                                   VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="HaloPixelLyric" FontSize="21" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="7" Padding="8,2" Margin="10,2,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="AboutVersionText" Text="v1.4.0"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="把网易云音乐正在播放的歌词，实时推送到花再 Halo PixelBar 像素屏。"
                                                           FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock FontSize="11.5" LineHeight="19" Margin="0,10,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="通过 CEF 标准调试接口（CDP）读取播放进度与歌词，不注入 DLL、不读写进程内存、不依赖网易云版本偏移；播放器升级后通常无需跟进。" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button x:Name="GithubBtn" Style="{StaticResource AccentButton}"
                                                            Content="在 GitHub 上查看" Click="GithubBtn_Click" />
                                                    <Button x:Name="ReleasesBtn" Style="{StaticResource SoftButton}"
                                                            Content="检查更新" Margin="10,0,0,0"
                                                            Click="ReleasesBtn_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="致谢" Style="{StaticResource SectionTitle}" />
                                            <TextBlock FontSize="11.5" LineHeight="20" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="HID 通信层源自 HaloPixelToolBox（MIT）｜协议参考 halo-pixelbar-mcp（MIT）&#x0a;播放进度与歌词来自网易云音乐 CEF 调试接口，仅供学习研究，与花再、网易云官方无关联。" />
                                            <Border Height="1" Background="{DynamicResource SeparatorBrush}"
                                                    Margin="0,14,0,12" />
                                            <TextBlock Text="© 2026 HaloPixelLyric · MIT License" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="系统" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock x:Name="OsText" Text="Windows" FontSize="12"
                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="运行时" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock x:Name="RuntimeText" Text=".NET" FontSize="12"
                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="日志文件" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="exe 同目录 halolyric.log" FontSize="12"
                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============================== Toast ============================== -->
            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,66,0,0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Panel.ZIndex="80" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Direction="270" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="ToastText" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ============================== 确认对话框 ============================== -->
            <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="{DynamicResource DialogOverlayBrush}"
                  Panel.ZIndex="90" Opacity="0">
                <Border x:Name="DialogCard" Width="400" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="24" HorizontalAlignment="Center"
                        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DialogScale" ScaleX="0.94" ScaleY="0.94" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" Text="需要重启网易云音乐" FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="DialogMessage" FontSize="12.5" LineHeight="20" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="DialogCancel" Style="{StaticResource SoftButton}" Content="取消"
                                    Width="88" Height="34" Click="DialogCancel_Click" />
                            <Button x:Name="DialogOk" Style="{StaticResource AccentButton}" Content="确定"
                                    Width="88" Height="34" Margin="10,0,0,0" Click="DialogOk_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================== 启动动画 ============================== -->
            <Grid x:Name="Splash" Background="{DynamicResource SplashBackgroundBrush}" Panel.ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                    <Image x:Name="SplashLogo" Source="{StaticResource AppLogoImage}" Width="96" Height="96"
                           RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="SplashName" Text="HaloPixelLyric" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SplashSub" Text="把歌词送进像素屏" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,7,0,0" Opacity="0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Width="160" Height="3" CornerRadius="1.5" Margin="0,30,0,0"
                            HorizontalAlignment="Center" Background="{DynamicResource TrackBrush}">
                        <Border x:Name="SplashProgress" Width="0" Height="3" CornerRadius="1.5"
                                HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
