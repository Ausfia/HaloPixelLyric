<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色主题：接近 macOS 深色模式的低对比层次 ===== -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1F1F24" Offset="0" />
        <GradientStop Color="#161619" Offset="0.55" />
        <GradientStop Color="#1F1D26" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#990F0F12" />
    <SolidColorBrush x:Key="CardBrush" Color="#26262B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A41" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#26FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6AD" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E7E86" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E95FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0066CC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#152A44" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B2220" />

    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#323238" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3B3B42" />
    <SolidColorBrush x:Key="TrackBrush" Color="#4A4A51" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#2E2E34" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#B0291B" />

    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />

    <LinearGradientBrush x:Key="GlowBrush1" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D2F7DFF" Offset="0" />
        <GradientStop Color="#002F7DFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlowBrush2" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#335447E8" Offset="0" />
        <GradientStop Color="#005447E8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F7DFF" Offset="0" />
        <GradientStop Color="#1D54D8" Offset="0.52" />
        <GradientStop Color="#5A49E8" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeroPillBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="HeroPillBorderBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="HeroSecondaryTextBrush" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonHoverBrush" Color="#EAF1FF" />
    <SolidColorBrush x:Key="HeroButtonStopBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonStopHoverBrush" Color="#42FFFFFF" />

</ResourceDictionary>
