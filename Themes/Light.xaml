<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 浅色主题：macOS Sonoma 风格的灰白层次 ===== -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F7FB" Offset="0" />
        <GradientStop Color="#EFEFF5" Offset="0.55" />
        <GradientStop Color="#F5F2FA" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#F7F7FB" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#B8ECECF3" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E8E8EE" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9BA1" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A7AFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0070E8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062CC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9F1FF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#2FBF5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFECEA" />

    <SolidColorBrush x:Key="HoverBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ControlBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E9E9F0" />
    <SolidColorBrush x:Key="TrackBrush" Color="#DCDCE3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3D000000" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#14000000" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FAFAFD" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E7E7EB" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#D8D8DE" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#B0291B" />

    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#1A000000" />

    <LinearGradientBrush x:Key="GlowBrush1" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D7DB8FF" Offset="0" />
        <GradientStop Color="#007DB8FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlowBrush2" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#337A5CFF" Offset="0" />
        <GradientStop Color="#007A5CFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A9AFF" Offset="0" />
        <GradientStop Color="#1F6BFA" Offset="0.52" />
        <GradientStop Color="#6B5BFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeroPillBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="HeroPillBorderBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="HeroSecondaryTextBrush" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonHoverBrush" Color="#F0F4FF" />
    <SolidColorBrush x:Key="HeroButtonStopBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="HeroButtonStopHoverBrush" Color="#42FFFFFF" />

</ResourceDictionary>
